{
  "name": "ripple",
  "version": "0.3.0",
  "description": "See what your changes reach: a map of everything that depends on your diff, drawn inside Claude Code",
  "author": {
    "name": "Neal",
    "url": "https://github.com/nsodhi-cmu"
  },
  "homepage": "https://github.com/nsodhi-cmu/claude-code-ripple",
  "repository": "https://github.com/nsodhi-cmu/claude-code-ripple",
  "license": "Apache-2.0",
  "keywords": [
    "mod",
    "impact-analysis",
    "call-graph",
    "diff",
    "code-review"
  ],
  "types": "./types/index.d.ts",
  "dependencies": [
    "graphlet"
  ],
  "userConfig": {
    "view": {
      "type": "string",
      "title": "Default view",
      "description": "How the map is drawn when it opens: as a graph of boxes and links, or as a tree.",
      "options": [
        "graph",
        "tree"
      ],
      "default": "graph"
    }
  }
}
